# Zavia Agent — copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file to GitHub (it is in .gitignore).

# Base URL for API calls. Use the vercel.app URL — the custom domain
# (zaviamagazine.dev) sometimes returns HTTP 000 from some networks.
ZAVIA_BASE_URL=https://zavia-magazine.vercel.app

# Publish token for the Zavia publish/update API.
# This is the token used as: Authorization: Bearer <token>
# Keep it secret. Never paste it into chat, code, or a public repo.
ZAVIA_PUBLISH_TOKEN=
